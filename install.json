[{
  "method": "shell.run",
  "params": {
    "message": "git clone https://github.com/R3gm/SoniTranslate.git ."
  }
}, {
  "method": "shell.run",
  "params": {
    "venv": "env",
    "message": [
      "pip install torch torchvision torchaudio --force-reinstall --index-url https://download.pytorch.org/whl/cu118",
      "pip install -r requirements.txt"
    ]
  }
}, {
  "method": "fs.link",
  "params": {
    "path": "weights",
    "to": "weights"
  }
}, {
  "method": "fs.link",
  "params": {
    "path": "_XTTS_",
    "to": "_XTTS_"
  }
}, {
  "method": "notify",
  "params": {
    "html": "Click the 'start' tab to launch the app"
  }
}]
